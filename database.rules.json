{
  "rules": {
    ".read": false,
    ".write": false,

    "vales": {
      ".read": "auth != null",
      "$valeId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id']) && (newData.hasChildren(['valorOriginal']) || newData.hasChildren(['valor']))",
        "id": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "valorOriginal": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)"
        },
        "valor": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0) || newData.isString()"
        },
        "baixas": {
          "$baixaId": {
            ".validate": "newData.hasChildren(['valorUsado'])",
            "valorUsado": {
              ".validate": "(newData.isNumber() && newData.val() > 0) || newData.isString()"
            }
          }
        }
      }
    },

    "notasPrazo": {
      ".read": "auth != null",
      ".indexOn": ["numeroControle", "cliente", "dataVencimento", "status"],
      "$notaId": {
        ".write": "auth != null && (!data.exists() || newData.exists())",
        ".validate": "newData.hasChildren(['id', 'valorOriginal', 'dataEmissao']) && (!data.exists() || data.child('status').val() !== 'CANCELADA' || newData.val() === data.val())",
        "id": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "numeroControle": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "valorOriginal": {
          ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val())"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'ABERTA' || newData.val() === 'PARCIAL' || newData.val() === 'QUITADA' || newData.val() === 'CANCELADA')"
        },
        "pagamentos": {
          "$pagtoId": {
            ".write": "auth != null && newData.exists()",
            ".validate": "newData.hasChildren(['id', 'valor', 'numeroRecibo']) && (!data.exists() ? (data.parent().parent().child('status').val() !== 'QUITADA' && data.parent().parent().child('status').val() !== 'CANCELADA') : true)",
            "id": {
              ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
            },
            "valor": {
              ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val())"
            },
            "numeroRecibo": {
              ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
            },
            "status": {
              ".validate": "newData.isString() && (newData.val() === 'ATIVO' || newData.val() === 'ESTORNADO')"
            }
          }
        }
      }
    },

    "clientes": {
      ".read": "auth != null",
      ".indexOn": ["codigo", "nome", "cpfCnpj"],
      "$clienteId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'nome'])",
        "id": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "codigo": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "limiteCredito": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0) || newData.isString()"
        }
      }
    },

    "sequencias": {
      ".read": "auth != null",
      "notasPrazo": {
        ".write": "auth != null && newData.isNumber() && (!data.exists() || newData.val() > data.val())"
      },
      "recibos": {
        ".write": "auth != null && newData.isNumber() && (!data.exists() || newData.val() > data.val())"
      },
      "clientes": {
        ".write": "auth != null"
      },
      "notasInutilizadas": {
        ".write": "auth != null"
      },
      "recibosInutilizados": {
        ".write": "auth != null"
      }
    },

    "configuracoes": {
      ".read": "auth != null",
      "empresa": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['nomeFantasia'])",
        "nomeFantasia": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "diasAlertaVencimento": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 30) || newData.isString()"
        }
      },
      "seguranca": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['hashSenhaMaster'])",
        "hashSenhaMaster": {
          ".validate": "newData.isString() && newData.val().length > 0"
        }
      }
    }
  }
}
